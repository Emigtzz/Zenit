# Copia este archivo a .env y ajusta los valores.
PORT=3000
DB_PATH=./data/zenit.db

# Datos que salen en el ticket. IMPORTANTE: usa comillas si el valor lleva "#" (en .env lo que sigue a # es comentario)
NEGOCIO_NOMBRE="Luna de precios"
NEGOCIO_DIRECCION="Av. 20 de noviembre #185"
NEGOCIO_LEYENDA="Gracias por su compra"

# Impresora: console (imprime en la terminal) | file (guarda en data/tickets/) | real (ESC/POS)
PRINTER_MODE=console
# Solo para PRINTER_MODE=real. Ejemplos: tcp://192.168.1.50  |  printer:NombreEnWindows
PRINTER_INTERFACE=
# Ancho del ticket en caracteres (80 mm = 48 columnas con la fuente normal)
PRINTER_COLUMNS=48

# Descuento de mayoreo en porcentaje
MAYOREO_PORCENTAJE=5

# --- Importación de facturas ---
# El costo de cada producto incluye IVA y demás impuestos (true) o es el importe antes de impuestos (false).
# En la pantalla de revisión se puede cambiar factura por factura.
COSTO_INCLUYE_IMPUESTOS=true

# Lectura de facturas en PDF con IA (opcional; el XML NO la necesita). Requiere internet.
# Obtén una clave en https://console.anthropic.com. Sin clave, los PDF no se pueden leer automáticamente.
# OJO: el contenido del PDF se envía a Anthropic para leerlo.
ANTHROPIC_API_KEY=
# Modelo para leer los PDF (por defecto claude-opus-5-5).
IA_MODELO=claude-opus-5-5

# --- Estadísticas ---
# Zona horaria de la tienda: define dónde cae la medianoche de "las ventas de hoy". Nombre IANA.
# Ciudad de México y casi todo el país: America/Mexico_City · Quintana Roo: America/Cancun · Sonora: America/Hermosillo
# Baja California: America/Tijuana · Chihuahua: America/Chihuahua · Sinaloa/Nayarit: America/Mazatlan
NEGOCIO_ZONA_HORARIA=America/Mexico_City

# --- Sincronización con la nube (Supabase) para la app del dueño. Opcional: sin esto la caja funciona igual. ---
# Guía paso a paso: supabase/LEEME.md. URL y clave "anon/publishable" están en Supabase → Project Settings → API.
# SYNC_EMAIL/SYNC_PASSWORD son el usuario de la CAJA que creaste en Supabase (con permisos solo de su negocio).
# NUNCA pongas aquí la clave "service_role" ni la contraseña de la base de datos.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SYNC_EMAIL=
SYNC_PASSWORD=
# Cada cuántos segundos revisa si hay algo que subir y avisa que la caja sigue conectada (mínimo 15)
SYNC_INTERVALO_SEG=60
