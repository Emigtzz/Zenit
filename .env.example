# Copia este archivo a .env y ajusta los valores.
PORT=3000
DB_PATH=./data/zenit.db

# Datos que salen en el ticket. IMPORTANTE: usa comillas si el valor lleva "#" (en .env lo que sigue a # es comentario)
NEGOCIO_NOMBRE="Luna de precios"
NEGOCIO_DIRECCION="Av. 20 de noviembre #185"
NEGOCIO_LEYENDA="Gracias por su compra"

# Impresora: console (imprime en la terminal) | file (guarda en data/tickets/) | real (ESC/POS)
PRINTER_MODE=console
# Solo para PRINTER_MODE=real. Ejemplos: tcp://192.168.1.50  |  printer:NombreEnWindows
PRINTER_INTERFACE=
# Ancho del ticket en caracteres (80 mm = 48 columnas con la fuente normal)
PRINTER_COLUMNS=48

# Descuento de mayoreo en porcentaje
MAYOREO_PORCENTAJE=5
